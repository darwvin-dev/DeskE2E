{
  "version": 1,
  "framework": "electron",
  "app": {
    "executablePath": "../node_modules/.bin/electron",
    "args": [
      "fixtures/electron-smoke/main.cjs"
    ],
    "cwd": "..",
    "timeoutMs": 60000
  },
  "scenarios": [
    {
      "name": "Fill and persist UI state",
      "steps": [
        {
          "action": "expectVisible",
          "selector": "testid:name"
        },
        {
          "action": "fill",
          "selector": "testid:name",
          "text": "Desktop QA"
        },
        {
          "action": "expectValue",
          "selector": "testid:name",
          "text": "Desktop QA"
        },
        {
          "action": "click",
          "selector": "testid:save"
        },
        {
          "action": "expectText",
          "selector": "testid:status",
          "text": "Saved: Desktop QA"
        },
        {
          "action": "screenshot",
          "name": "passed"
        }
      ]
    }
  ]
}
